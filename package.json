{
  "name": "dsh-onecompany",
  "version": "0.1.0",
  "description": "一人公司（One-Person Company）：为 DeepSeek Harness 提供多 agent 公司编排——员工/CEO、项目群与大厅会话、任务与信箱、审批流、定时排班、资料库 ACL、工作日志与 token 统计",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "agents/agt_ceo.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node build.mjs --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "cron-parser": "^5.3.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiazhi88/dsh-onecompany.git"
  },
  "homepage": "https://github.com/xiazhi88/dsh-onecompany",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "agent-orchestration",
    "cordis"
  ]
}